uint8 MODE_JOINT=0
uint8 MODE_CARTESIAN=1

uint8 DIRECTION_NEGATIVE=0
uint8 DIRECTION_POSITIVE=1

uint8 ACTION_STOP=0
uint8 ACTION_START=1
uint8 ACTION_KEEPALIVE=2

# mode selects joint or Cartesian jogging.
# axis is 0..5: J1..J6, or X/Y/Z/RX/RY/RZ.
uint8 mode
uint8 axis
uint8 direction
uint8 action
---
bool success
string message
